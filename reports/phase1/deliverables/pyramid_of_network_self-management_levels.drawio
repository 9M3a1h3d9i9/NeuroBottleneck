        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% تعریف استایل‌های متمایز برای سطوح هرم در draw.io\n    classDef manualStyle fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px,color:#616161;\n    classDef partialStyle fill:#fff3e0,stroke:#ffb74d,stroke-width:2px,color:#000;\n    classDef targetStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:4px,color:#000;\n    classDef highStyle fill:#e1f5fe,stroke:#4fc3f7,stroke-width:2px,color:#000;\n    classDef arrowStyle stroke:#c62828,stroke-width:3px,stroke-dasharray: 5 5;\n\n    subgraph Pyramid [هرم استانداردهای خودگردانی شبکه ETSI TS 128 100]\n        L5[سطح L5: خودگردانی کامل - Full Autonomy &lt;br&gt; خودبهینه‌سازی تمام‌عیار در تمام شرایط و دامنه‌ها]:::manualStyle\n        \n        L4[سطح L4: خودگردانی بالا - High Autonomy &lt;br&gt; مدیریت مبتنی بر نیت Intent-Driven &lt;br&gt; سیستم مسئول کامل تحلیل، تصمیم و اجرا]:::targetStyle\n        \n        L3[سطح L3: خودگردانی مشروط - Conditional Autonomy &lt;br&gt; سیستم اجرا میکند؛ انسان ناظر و تاییدکننده خطوط بحرانی]:::partialStyle\n        \n        L2[سطح L2: خودگردانی جزئی - Partial Autonomy &lt;br&gt; سیاست‌های ایستا و مبتنی بر قوانین فیکس Rule-based]:::partialStyle\n        \n        L1[سطح L1: مهندسی کمکی - Assisted &lt;br&gt; اسکریپت‌های دستی و اتوماسیون‌های مجزا]:::manualStyle\n        \n        L0[سطح L0: عملیات کاملاً دستی - Manual &lt;br&gt; پایش و پیکربندی سنتی توسط تکنسین شبکه]:::manualStyle\n\n        %% اتصالات سلسله مراتبی هرم\n        L5 --- L4\n        L4 --- L3\n        L3 --- L2\n        L2 --- L1\n        L1 --- L0\n    end\n\n    subgraph ProjectMapping [نگاشت توابع اختصاصی پلتفرم NeuroBottleneck در سطح L4]\n        M1[گیرنده نیت اپراتور Intent API &lt;br&gt; از طریق SMO / Non-RT RIC]:::highStyle --&gt; L4\n        M2[تحلیل لایه تله‌متری و شناسایی گلوگاه &lt;br&gt; توسط هسته GraphSAGE GNN]:::highStyle --&gt; L4\n        M3[تصمیم‌گیری خودکار بازآرایی مسیر &lt;br&gt; توسط عامل هوشمند PPO DRL]:::highStyle --&gt; L4\n        M4[ضمانت پایداری و ۱۰۰٪ ایمن لایه رادیویی &lt;br&gt; توسط Deterministic Action Masking]:::highStyle --&gt; L4\n    end\n\n    subgraph Innovation [جهش استراتژیک شبکه همراه اول]\n        Current[وضعیت کنونی اپراتور: سطح L2/L3]:::partialStyle\n        Target[هدف فاز جاری: استقرار لایه خودترمیمی L4]:::targetStyle\n        Current ==&gt; |\&quot;تزریق پلتفرم هوشمند NeuroBottleneck (حلقه بسته Near-RT RIC)\&quot;| Target\n    end\n\n    %% لایه‌های پانویس و اتصالات مستقیم به مراجع علمی\n    note1[مرجع استاندارد: ETSI TS 128 100 V19.0.0 2025-10] .- L5\n    note2[محیط استقرار صنعتی: معماری O-RAN Near-Real-Time RIC] .- M3&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-FQWiQyKjgTx6eQtCoGG-1">
